# Copy this to .env and fill in real values before deploying

POSTGRES_DB=DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# AI Agent
GEMINI_API_KEY=AQ......
# PAT of the dedicated AI-agent GitHub account (must have write access to target repos)
GITHUB_TOKEN=ghp_...
ORCHESTRO_AGENT_USER=ai-agent
ORCHESTRO_AGENT_PASS=changeme-strong-password
# Git identity used for commits pushed by the agent
GIT_AUTHOR_NAME=orchestro-ai-agent
GIT_AUTHOR_EMAIL=ai-agent@example.com
